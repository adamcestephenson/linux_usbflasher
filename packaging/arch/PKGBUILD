# Maintainer: Adam Stephenson <adam_stephenson@hotmail.com>
pkgname=usb-flasher-git
_pkgname=linux_usbflasher
pkgver=0.1.0.r6.g7e89461
pkgrel=1
pkgdesc='Write disk images to USB drives and SD cards (GTK4/libadwaita, udisks2)'
arch=('any')
url='https://github.com/adamcestephenson/linux_usbflasher'
# The repository does not contain a license file yet; set this once it does.
license=('LicenseRef-unspecified')
depends=(
  'python'
  'python-gobject'
  'gtk4'
  'libadwaita'
  'udisks2'
  'polkit'
)
makedepends=(
  'git'
  'python-build'
  'python-installer'
  'python-setuptools'
  'python-wheel'
)
checkdepends=('python-pytest')
provides=('usb-flasher')
conflicts=('usb-flasher')
source=("$_pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  printf '0.1.0.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd "$_pkgname"
  python -m build --wheel --no-isolation
}

check() {
  cd "$_pkgname"
  # The GUI tests start their own headless Broadway display (from gtk4).
  python -m pytest -q -p no:cacheprovider
}

package() {
  cd "$_pkgname"
  python -m installer --destdir="$pkgdir" --prefix=/usr dist/*.whl

  install -Dm644 data/io.github.adamcestephenson.UsbFlasher.desktop \
    "$pkgdir/usr/share/applications/io.github.adamcestephenson.UsbFlasher.desktop"
  install -Dm644 data/icons/hicolor/scalable/apps/io.github.adamcestephenson.UsbFlasher.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.adamcestephenson.UsbFlasher.svg"
}
